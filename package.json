  "description": "Notion's page colours and type for BB, in light and dark, with Default, Serif and Mono for messages.",
  "license": "MIT",
  "author": "Max Kosach (https://github.com/KosachMax)",
  "homepage": "https://github.com/KosachMax/bb-plugin-notion-theme#readme",
